# Servicer key (testnet demo) - required for minting and running distributions
SERVICER_SECRET=SB...
# Optional real IPFS pinning (our CIDs match cidVersion=1)
# PINATA_JWT=
# TRANCHING_API_URL=http://localhost:8080
# Metadata encryption (AES-256-GCM) - seals the `confidential` section of NFT
# metadata before IPFS storage. Generate: openssl rand -hex 32
# Deleting the key = GDPR crypto-shredding (sealed sections become unreadable).
# METADATA_ENCRYPTION_KEY=
# Bearer token for GET /metadata/:cid/clear (authorized data-room view)
# METADATA_VIEWER_TOKEN=
