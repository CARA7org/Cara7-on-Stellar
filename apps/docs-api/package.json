{
  "name": "docs-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Base de connaissances locale : depot et indexation de documents (PDF, Word, Excel)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "start:prod": "prisma migrate deploy && tsx src/server.ts",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "adm-zip": "^0.6.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.11.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "prisma": "^7.9.1",
    "tsx": "^4.23.1",
    "word-extractor": "^1.0.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.10.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
