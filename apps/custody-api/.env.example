# custody-api: copy this file to .env and fill in the values.
#
# There are two processes and two sets of credentials:
#   - the server (pnpm start) uses the initiator service account (DFNS_*).
#   - the checker (pnpm checker) uses the checker service account (CHECKER_DFNS_*).
# In production, run the checker on a separate host. Give that host only the
# checker variables. Do not put the checker key on the server host, and do not
# put the initiator key on the checker host.

# ---------------------------------------------------------------------------
# Shared by the server and the checker (no secret)
# ---------------------------------------------------------------------------
STELLAR_NETWORK=testnet                 # testnet | mainnet; selects src/policy/<network>.json
DFNS_API_URL=https://api.dfns.io
DFNS_ORG_ID=or-xxxxx-xxxxx-xxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Server only
# ---------------------------------------------------------------------------
PORT=8091
HOST=127.0.0.1                          # 0.0.0.0 in production
DATABASE_URL="postgresql://YOUR_USER@localhost:5432/cara7_custody?schema=custody"
CORS_ORIGIN=http://localhost:3001       # the investor front origin; no other origin gets CORS
WEBAUTHN_RP_ID=localhost                # the passkey domain (the front host name)
WEBAUTHN_RP_NAME=CARA7
WEBAUTHN_ORIGIN=http://localhost:3001   # the origin where the browser creates the passkey
SESSION_TTL_HOURS=12
# Read-only network endpoints. The service never submits a transaction.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org
FRIENDBOT_URL=https://friendbot.stellar.org   # testnet only: funds each new wallet
# The initiator service account. It can start signature requests only.
DFNS_AUTH_TOKEN=
DFNS_CRED_ID=
# PEM private key of the credential, in one line with \n for the line breaks.
DFNS_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Checker only (put these on the checker host, not on the server host)
# ---------------------------------------------------------------------------
# The checker service account. It is in the approval group of the
# cara7:investor policy and votes on each pending signature request.
CHECKER_DFNS_AUTH_TOKEN=
CHECKER_DFNS_CRED_ID=
CHECKER_DFNS_PRIVATE_KEY=
CHECKER_INTERVAL_SECONDS=5
